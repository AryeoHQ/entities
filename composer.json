{
    "name": "aryeo/entities",
    "description": "Entity contracts for Eloquent models and plain classes, with generators and PHPStan and Rector rules.",
    "license": "MIT",
    "type": "library",
    "repositories": {
        "artifactory": {
            "type": "composer",
            "url": "https://artifactory.zgtools.net/artifactory/api/composer/listing-and-vendor-management-composer/",
            "only": ["aryeo/*", "zillow/*"]
        }
    },
    "require": {
        "php": "^8.5",
        "aryeo/eloquent-search": "0.0.22",
        "laravel/framework": "^12.37 || ^13",
        "laravel/prompts": "^0.3.8",
        "nikic/php-parser": "^5.7",
        "phpstan/phpstan": "^2.1",
        "symfony/console": "^7.4 || ^8.0",
        "aryeo/tooling-laravel": "0.0.43"
    },
    "require-dev": {
        "orchestra/testbench": "^10.6 || ^11",
        "phpunit/phpunit": "^12.4.1 || ^13",
        "nesbot/carbon": "^3.10",
        "orchestra/testbench-core": "^10.7 || ^11",
        "pestphp/pest": "^4.1"
    },
    "autoload": {
        "psr-4": {
            "Support\\Entities\\": "src/Support/Entities",
            "Tooling\\Entities\\": "src/Tooling/Entities"
        },
        "exclude-from-classmap": [
            "*Test.php",
            "*TestCases.php",
            "/tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Workbench\\App\\": "workbench/app/",
            "Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Justin Seliga",
            "email": "justinsel@zillowgroup.com"
        }
    ],
    "minimum-stability": "stable",
    "config": {
        "allow-plugins": {
            "aryeo/tooling-laravel": true,
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Support\\Entities\\Providers\\Provider"
            ]
        },
        "tooling": {
            "rector": {
                "configured_rules": "tooling/rector/configured-rules.php",
                "config": {
                    "paths": [
                        "src",
                        "tests/Fixtures/Support",
                        "workbench"
                    ]
                }
            },
            "phpstan": {
                "rules": "tooling/phpstan/rules.neon",
                "config": {
                    "paths": [
                        "src",
                        "tests/Fixtures/Support",
                        "workbench"
                    ]
                }
            },
            "pint": {
                "config": {
                    "paths": [
                        "src",
                        "tests",
                        "workbench"
                    ]
                }
            }
        }
    }
}
